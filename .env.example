# Neon Postgres connection string (injected by Vercel when Neon is connected)
DATABASE_URL=

# ABM workflow API keys — required for /api/signals, /api/stored-signals and /api/all-stored-signals.
# Set these in Vercel project settings / .env.local — never commit real keys.
ABM_API_KEY=
ABM_ALL_SIGNALS_API_KEY=
